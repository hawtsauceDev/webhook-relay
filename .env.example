POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=db_name

DATABASE_URL=postgresql+psycopg://postgres_user:postgres_password@postgres:5432/db_name
TEST_DATABASE_URL=postgresql+psycopg://postgres_user:postgres_password@localhost:5432/test_db_name
SQL_ECHO=False
CELERY_BROKER_URL=redis://redis:6379/0
# Max request body size in bytes; defaults in config.py if unset
#MAX_REQUEST_BODY_SIZE=1048576
